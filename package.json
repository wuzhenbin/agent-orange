{
    "name": "orange-agent-harness",
    "version": "0.0.4",
    "description": "agent harness enginess with tui",
    "type": "module",
    "scripts": {
        "dev": "bun run src/cli.ts",
        "start": "bun run src/cli.ts",
        "build": "tsgo -p tsconfig.json",
        "prepublishOnly": "npm run build",
        "pack:check": "npm pack --dry-run",
        "clean": "rm -rf dist"
    },
    "bin": {
        "orange": "./dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "dependencies": {
        "@earendil-works/pi-tui": "^0.79.9",
        "@iarna/toml": "^2.2.5",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@silvia-odwyer/photon-node": "^0.3.4",
        "chalk": "^5.6.2",
        "cross-spawn": "^7.0.6",
        "diff": "^9.0.0",
        "highlight.js": "^11.11.1",
        "ignore": "^7.0.5",
        "openai": "^6.42.0",
        "partial-json": "^0.1.7",
        "proper-lockfile": "^4.1.2",
        "typebox": "^1.2.16",
        "yaml": "^2.9.0"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/cross-spawn": "^6.0.6",
        "@types/node": "^26.2.0",
        "@types/proper-lockfile": "^4.1.4",
        "prettier": "^3.8.3",
        "typescript": "^5"
    },
    "publishConfig": {
        "access": "public"
    }
}
